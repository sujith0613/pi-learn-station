# Pi Learning Station backend + SPA, arm64 (built via podman --platform).
# Mirrors the repo layout at /app so relative path logic stays untouched.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    numpy \
    pydantic \
    onnxruntime==1.28.0

COPY backend/app /app/backend/app
COPY web/dist /app/web/dist
COPY models /app/models

WORKDIR /app/backend

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]